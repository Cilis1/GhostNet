# Turns res/fonts/*.ttf into a C++ source of byte arrays (run with cmake -P).
# Inputs: OUT (file to write), DIR (font folder), NAMES (font base names).
set(src "// Generated by cmake/embed_fonts.cmake - do not edit.\n#include <cstddef>\n#include <cstring>\n\n")
set(table "")
set(i 0)
string(REPLACE "," ";" NAMES "${NAMES}")
foreach(name ${NAMES})
  file(READ "${DIR}/${name}.ttf" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR bytes "${n} / 2")
  string(REGEX REPLACE "(................................................................)" "\\1\n" hex "${hex}")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(APPEND src "static const unsigned char kFont${i}[${bytes}] = {\n${hex}\n};\n")
  string(APPEND table "    {\"${name}\", kFont${i}, ${bytes}},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND src "\nstruct EmbeddedFont { const char* name; const unsigned char* data; size_t size; };\n")
string(APPEND src "static const EmbeddedFont kFonts[] = {\n${table}};\n\n")
string(APPEND src "const unsigned char* embeddedFont(const char* name, int* size) {\n")
string(APPEND src "    for (const auto& f : kFonts)\n        if (!std::strcmp(f.name, name)) { *size = static_cast<int>(f.size); return f.data; }\n")
string(APPEND src "    *size = 0;\n    return nullptr;\n}\n")
file(WRITE "${OUT}" "${src}")
